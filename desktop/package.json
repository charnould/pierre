  "main": "./dist/main/main.js",
  "scripts": {
    "shadcnscan": "bunx @shadscan/cli",
    "dev": "electron-vite dev --outDir=dist",
    "build": "electron-vite build --outDir=dist",
    "start": "electron-vite preview --outDir=dist",
    "package": "bun run build && electron-forge package",
    "make": "bun run build && electron-forge make",
    "publish": "bun run build && electron-forge publish",
    "perf:measure": "bun perf/cli.ts measure",
    "perf:check": "bun perf/cli.ts check",
    "perf:baseline": "bun perf/cli.ts baseline",
    "perf:bench": "bun perf/cli.ts bench",
    "perf:report": "bun perf/cli.ts report",
    "test": "TZ=Europe/Paris bun test",
    "test:watch": "TZ=Europe/Paris bun test --watch",
    "typecheck": "tsc --noEmit",
    "postinstall": "node node_modules/electron/install.js"
  },
