#
# NE PAS MODIFIER LES NOMS DES VARIABLES D'ENVIRONNEMENT.
# NE PAS SUPPRIMER OU AJOUTER DE VARIABLES D'ENVIRONNEMENT.
#

#
#
#
# ADRESSE IP + HOTE
#

# Remplacer l'IP par celui de votre serveur.
IP=139.227.746.345

# Le port à utiliser pour se connecter par SSH au serveur dont l'IP est référencé ci-dessus.
# Assurez-vous que le port est bien ouvert sans quoi le déploiement ne fonctionnera pas.
# Les ports 80 (http) et 443 (https) doivent également et IMPÉRATIVEMENT être ouverts.
SSH_PORT=22

# Indiquer le nom de sous-domaine/domaine associé à votre serveur.
# Un certificat SSL sera automatiquement créé lors du déploiement.
HOST=assistant.pierre-ia.org

#
#
#
#
# AUTHENTICATION
#

# Une clef secrète pour s'authentifier à PIERRE via cURL.
# C'est particulièrement utile lorsque l'on souhaite automatiser
# le processus d'upload de connaissances propriétaires sans passer
# par l'interface web.
# Saisissez dans votre Terminal `openssl rand -hex 16` pour en générer une.
AUTH_BEARER=c7eae906a39f93885558bcf747754eee

# Une clef secrète pour signer les cookies Better Auth.
# Saisissez dans votre Terminal `openssl rand -base64 32` pour en générer une.
AUTH_SECRET=d5a5a154f4336bc349721098f6c2a7e8

# Mot de passe du compte `admin@pierre-ia.org`.
# Ce compte est créé au démarrage du serveur s'il n'existe pas encore.
# Entre 8 et 128 caractères. Changez-le avant de déployer.
AUTH_PASSWORD=changez-moi-svp

#
#
#
#
# LARGE LANGUAGE MODEL + API KEY
#

# Le type de modèle de langage à utiliser.
# "openai"      fonctionne avec tous les modèles de langage compatibles avec l'API d'OpenAI,
#               y compris ceux d'autres fournisseurs compatibles avec cette API.
#
# "anthropic"   fonctionne avec les modèles de langage d'Anthropic.   
AI_TYPE=openai

# Le modèle de langage à utiliser.
# Il doit être compatible avec le type de modèle référencé ci-dessus.
AI_MODEL=gpt-5.4-mini

# L'url de base de l'API du modèle de langage référencé ci-dessus.
# Si vous utilisez Anthropic : https://api.anthropic.com
# Si vous utilisez OpenAI : https://api.openai.com/v1
# Si vous utilisez un fournisseur compatible avec l'API d'OpenAI : renseignez ici l'url de base de l'API de ce fournisseur.
AI_BASE_URL=https://api.openai.com/v1

# La clef d'API pour accéder au modèle de langage référencé ci-dessus.
AI_API_KEY=sk-proj-fake-key-pGxRDAE069XAHd5X56MU22lEg

#
#
#
#
# CM.COM - RCS
#
# https://developers.cm.com/messaging/docs/rcs-text-message
# https://developers.cm.com/messaging/docs/rcs-media-message
# https://developers.cm.com/messaging/docs/rcs-suggested-replies-messages
# https://developers.cm.com/messaging/docs/rcs-rich-card-messages
# https://developers.cm.com/messaging/docs/rcs-carousel-messages
#

# Product token UUID (avec tirets). Channels → API Access and Settings →
# Authentication → Product Tokens. Ce n'est NI l'Account ID, NI l'API Key.
# https://developers.cm.com/messaging/docs/channels-authentication
CM_PRODUCT_TOKEN=00000000-0000-0000-0000-000000000000

# Nom d'expéditeur RCS : doit matcher EXACTEMENT le sender name de l'agent
# enregistré chez CM.com (souvent max. 11 caractères alphanumériques).
CM_FROM=PIERRE

# Valeur de la clef secrète pour vérifier l'authenticité des webhooks envoyés par CM.com.
# Saisissez dans votre Terminal `openssl rand -hex 16` pour en générer une.
CM_WEBHOOK_SECRET=215d6e0b94303ab79d6af6b288c05581