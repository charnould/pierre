{
  "name": "@pierre/server",
  "version": "0.40.6",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "vm:build:osx": "bash ../config/build-smolvm.sh",
    "vm:build:linux": "bash ../config/build-smolvm-linux.sh",
    "server:build": "cd .. && bun --env-file=.env run config/build-server.ts",
    "release:build": "bash utils/build-release.sh",
    "dev": "DEBUG=true bun --env-file=../.env --watch run serve.ts",
    "embed": "BUN_PORT=3001 bun --watch tests/e2e/host-demo.html",
    "wikipedia": "bun --env-file=../.env run ./utils/knowledge/scrape-wikipedia.ts",
    "test:e2e": "bun run tests/e2e/run.ts",
    "test:unit": "bun test unit --env-file=../.env",
    "typecheck": "tsc --noEmit",
    "bench:schema": "bun run tests/bench/schema.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@huggingface/tokenizers": "^0.2.0",
    "better-auth": "^1.7.5",
    "date-fns": "catalog:",
    "docxtemplater": "catalog:",
    "hono": "^4.13.8",
    "jsdom": "catalog:",
    "libphonenumber-js": "^1.13.12",
    "mammoth": "^1.12.2",
    "onnxruntime-node": "^1.30.0",
    "oxfmt": "catalog:",
    "pizzip": "catalog:",
    "reamkit": "^1.29.0",
    "turndown": "^7.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/turndown": "^5.0.6",
    "typescript": "catalog:"
  }
}
