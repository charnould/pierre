{
  "name": "@pierre/server",
  "version": "0.40.6",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "vm:build:osx": "bash ../config/build-smolvm.sh",
    "vm:build:linux": "bash ../config/build-smolvm-linux.sh",
    "server:build": "cd .. && bun --env-file=.env.production run config/build-server.ts",
    "dev": "DEBUG=true bun --env-file=../.env.production --watch run start.ts",
    "embed": "BUN_PORT=3001 bun --watch tests/e2e/host-demo.html",
    "start": "NODE_ENV=production bun run start.ts",
    "wikipedia": "bun --env-file=../.env.production run ./utils/knowledge/scrape-wikipedia.ts",
    "pierre:version": "bun run utils/update-pierre.ts",
    "test:e2e": "bun test e2e --timeout 60000 --env-file=../.env.production --preload ./utils/setup.ts",
    "test:unit": "bun test unit --env-file=../.env.production --preload ./utils/setup.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@observablehq/plot": "catalog:",
    "arquero": "^8.0.3",
    "date-fns": "^4.4.0",
    "docxtemplater": "^3.69.3",
    "hono": "^4.13.5",
    "jsdom": "catalog:",
    "libphonenumber-js": "^1.13.12",
    "lodash": "^4.18.1",
    "lucide-react": "catalog:",
    "mammoth": "^1.12.2",
    "marked": "catalog:",
    "oxfmt": "catalog:",
    "pizzip": "^3.2.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reamkit": "^1.29.0",
    "streamdown": "catalog:",
    "turndown": "^7.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/lodash": "^4.17.25",
    "@types/react": "catalog:",
    "@types/react-dom": "^19.2.5",
    "@types/turndown": "^5.0.6",
    "puppeteer": "^25.9.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
