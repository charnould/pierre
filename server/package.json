{
  "name": "@pierre/server",
  "version": "0.40.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "vm:build:osx": "bash ../config/build-smolvm.sh",
    "vm:build:linux": "bash ../config/build-smolvm-linux.sh",
    "server:build": "cd .. && bun --env-file=.env.production run config/build-server.ts",
    "dev": "DEBUG=true bun --env-file=../.env.production --watch run app.ts",
    "modal": "bun --port=1984 tests/e2e/_open-modal.html & sleep 1 && open http://localhost:1984",
    "start": "NODE_ENV=production bun run app.ts",
    "wikipedia": "bun --env-file=../.env.production run ./utils/knowledge/scrape-wikipedia.ts",
    "pierre:version": "bun run utils/update-pierre.ts",
    "test:e2e": "bun test e2e --timeout 60000 --env-file=../.env.production --preload ./utils/setup.ts",
    "test:unit": "bun test unit --env-file=../.env.production --preload ./utils/setup.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@observablehq/plot": "^0.6.17",
    "arquero": "^8.0.3",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "hono": "^4.12.26",
    "jsdom": "^29.1.1",
    "lodash": "^4.18.1",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.5",
    "oxfmt": "^0.55.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "streamdown": "^2.5.0",
    "turndown": "^7.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^28.0.3",
    "@types/lodash": "^4.17.24",
    "@types/react": "^19.2.17",
    "@types/turndown": "^5.0.6",
    "markdown-toc": "^1.2.0",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  }
}
