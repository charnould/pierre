{
  "name": "pierre",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Charles-Henri ARNOULD <charnould@pierre-ia.org>",
  "type": "module",
  "module": "app.ts",
  "scripts": {
    "------------------ DESKTOP ------------------": "------------------",
    "desktop:make": "cd desktop && bun run make",
    "desktop:release": "bash config/release:desktop.sh",
    "------------------ BUILD ------------------": "------------------",
    "vm:build:osx": "bash config/build:smolvm.sh",
    "vm:build:linux": "bash config/build:smolvm:linux.sh",
    "app:build": "bun --env-file=.env.production run config/build:app.ts",
    "------------------ GLOBAL ------------------": "------------------",
    "dev": "DEBUG=true bun --env-file=.env.production --watch run app.ts",
    "css": "bunx @tailwindcss/cli@latest -i assets/tailwind/style.css -o assets/dist/css/style.css --minify --watch",
    "start": "NODE_ENV=production bun --env-file=.env.production run app.ts",
    "lint": "bun run oxlint -c ./config/oxlint.jsonc . --fix --fix-suggestions --fix-dangerously",
    "format": "bun run oxfmt -c ./config/oxfmt.jsonc",
    "generate:wikipedia": "bun --env-file=.env.production run ./utils/knowledge/scrape-wikipedia.ts",
    "generate:knowledge": "bun --env-file=.env.production run ./utils/knowledge/build-knowledge.ts",
    "generate:updates": "bun run config/build:updates.ts",
    "transpile": "bun build --entrypoints assets/scripts/ai.tsx assets/scripts/widget.ts --outdir assets/dist/js --minify --target browser --watch",
    "pierre:config": "bun test check-config",
    "pierre:version": "bun run utils/update-pierre.ts",
    "------------------ LLM EVAL + TESTS ------------------": "------------------",
    "test:e2e": "bun test e2e --timeout 60000 --env-file=.env.production --preload ./utils/setup.ts",
    "test:unit": "bun test unit --env-file=.env.production --preload ./utils/setup.ts",
    "------------------ STAGING ------------------": "------------------",
    "staging:logs": "bun --env-file=.env.staging run kamal app logs",
    "staging:setup": "bun --env-file=.env.staging run kamal setup",
    "staging:deploy": "bun --env-file=.env.staging run kamal deploy",
    "staging:console": "bun --env-file=.env.staging run kamal app exec -i bash",
    "------------------ PRODUCTION ------------------": "------------------",
    "prod:logs": "bun --env-file=.env.production run kamal app logs",
    "prod:setup": "bun --env-file=.env.production run kamal setup",
    "prod:deploy": "bun --env-file=.env.production run kamal deploy",
    "prod:console": "bun --env-file=.env.production run kamal app exec -i bash"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@observablehq/plot": "^0.6.17",
    "arquero": "^8.0.3",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "hono": "^4.12.26",
    "jsdom": "^29.1.1",
    "lodash": "^4.18.1",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.5",
    "oxfmt": "^0.54.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "streamdown": "^2.5.0",
    "turndown": "^7.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^28.0.3",
    "@types/lodash": "^4.17.24",
    "@types/react": "^19.2.17",
    "@types/turndown": "^5.0.6",
    "markdown-toc": "^1.2.0",
    "oxlint": "^1.70.0",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  }
}
