{
  "name": "pierre",
  "private": true,
  "license": "See LICENSE.md",
  "author": "Charles-Henri ARNOULD <charnould@pierre-ia.org>",
  "workspaces": {
    "packages": [
      "docs",
      "server",
      "desktop",
      "cli",
      "marketing"
    ],
    "catalog": {
      "@tailwindcss/cli": "^4.3.5",
      "@types/bun": "^1.4.5",
      "@types/jsdom": "^30.0.0",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "docxtemplater": "^3.71.1",
      "jsdom": "^31.0.1",
      "lucide-react": "1.78.0",
      "marked": "^18.2.1",
      "oxlint": "^1.95.0",
      "pizzip": "^3.3.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "tailwindcss": "^4.3.5"
    }
  },
  "scripts": {
    "desktop:build": "bun desktop/build.ts",
    "desktop:dev": "bun desktop/dev.ts",
    "desktop:make": "bun desktop:build && bun run --cwd desktop make",
    "docs": "bun run --cwd docs generate",
    "knip": "knip --config ./config/knip.jsonc --no-config-hints",
    "knip:production": "knip --config ./config/knip.jsonc --no-config-hints --production --include files,dependencies",
    "server:build": "bun config/build-server.ts",
    "server:dev": "cd server && bun run ./utils/ensure-carl.ts && bun run ./utils/ensure-speech.ts && DEBUG=true bun --env-file=datastores/pierre.env --watch run serve.ts",
    "server:embed": "cd server && BUN_PORT=3001 bun --watch tests/e2e/host-demo.html",
    "server:env": "PIERRE_ENV_FILE=server/datastores/pierre.env bun cli/src/main.ts env --init",
    "server:microvm:macos": "bash server/microvm/scripts/build.sh darwin-arm64",
    "server:microvm:update": "bun server/microvm/update.ts",
    "server:wikipedia": "cd server && bun ./utils/knowledge/scrape-wikipedia.ts",
    "test:all": "bun config/test.ts all",
    "test:core": "bun config/test.ts core",
    "test:desktop": "bun config/test.ts desktop",
    "test:e2e": "bun config/test.ts e2e",
    "test:server": "bun config/test.ts server"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.5",
    "@types/bun": "catalog:",
    "knip": "^6.48.0",
    "oxlint": "catalog:"
  }
}
