{
  "name": "pierre",
  "version": "0.40.6",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Charles-Henri ARNOULD <charnould@pierre-ia.org>",
  "workspaces": {
    "packages": [
      "docs",
      "server",
      "desktop"
    ],
    "catalog": {
      "@types/bun": "^1.4.2",
      "@types/jsdom": "^30.0.0",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "date-fns": "^4.4.0",
      "docxtemplater": "^3.70.1",
      "jsdom": "^30.1.0",
      "lucide-react": "^1.47.0",
      "marked": "^18.0.13",
      "oxfmt": "^0.69.0",
      "oxlint": "^1.84.0",
      "pizzip": "^3.2.0",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "tailwindcss": "^4.3.3",
      "typescript": "^7.0.2"
    }
  },
  "scripts": {
    "------------------ GLOBAL ------------------": "------------------",
    "dev:server": "bun --filter @pierre/server dev",
    "dev:desktop": "bun --filter @pierre/desktop dev",
    "test:e2e": "bun --filter @pierre/server test:e2e",
    "lint": "bun run oxlint -c ./config/oxlint.jsonc --ignore-path=\"$PWD/config/oxlint.ignore\" . --fix --fix-suggestions --fix-dangerously",
    "lint:check": "bun run oxlint -c ./config/oxlint.jsonc --ignore-path=\"$PWD/config/oxlint.ignore\" .",
    "format": "bun run oxfmt -c ./config/oxfmt.jsonc --ignore-path=\"$PWD/config/oxfmt.ignore\"",
    "format:check": "bun run oxfmt -c ./config/oxfmt.jsonc --ignore-path=\"$PWD/config/oxfmt.ignore\" --check",
    "knip": "knip --config ./config/knip.jsonc --no-config-hints",
    "knip:production": "knip --config ./config/knip.jsonc --no-config-hints --production --include files,dependencies",
    "pierre:config": "bun test config/checks/",
    "docs": "bun --filter @pierre/docs build",
    "release": "bash config/release.sh",
    "pierre:version": "bun run server/utils/update-pierre.ts",
    "------------------ DEPLOY ------------------": "------------------",
    "deploy:logs": "bun --env-file=.env run kamal app logs -c config/deploy.yml",
    "deploy:setup": "bun --env-file=.env run kamal setup -c config/deploy.yml",
    "deploy": "bun --env-file=.env run kamal deploy -c config/deploy.yml",
    "deploy:console": "bun --env-file=.env run kamal app exec -i bash -c config/deploy.yml"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.1.5",
    "knip": "^6.37.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
