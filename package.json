{
  "name": "pierre",
  "private": true,
  "license": "See LICENSE.md",
  "author": "Charles-Henri ARNOULD <charnould@pierre-ia.org>",
  "workspaces": {
    "packages": [
      "docs",
      "server",
      "desktop",
      "cli"
    ],
    "catalog": {
      "@tailwindcss/cli": "^4.3.4",
      "@types/bun": "^1.4.4",
      "@types/jsdom": "^30.0.0",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "docxtemplater": "^3.71.1",
      "jsdom": "^30.1.3",
      "lucide-react": "1.67.0",
      "marked": "^18.1.3",
      "oxlint": "^1.90.0",
      "pizzip": "^3.3.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "tailwindcss": "^4.3.4"
    }
  },
  "scripts": {
    "desktop:build": "bun desktop/build.ts",
    "desktop:dev": "bun desktop/dev.ts",
    "desktop:make": "bun desktop:build && cd desktop && bun x electron-forge make",
    "desktop:package": "bun desktop:build && cd desktop && bun x electron-forge package",
    "desktop:start": "cd desktop && bun x electron .",
    "docs": "bun --filter @pierre/docs generate",
    "knip": "knip --config ./config/knip.jsonc --no-config-hints",
    "knip:production": "knip --config ./config/knip.jsonc --no-config-hints --production --include files,dependencies",
    "pierre:config": "bun test config/checks/",
    "pierre:version": "bun run server/utils/update-pierre.ts",
    "server:build": "bun config/build-server.ts",
    "server:dev": "cd server && bun run ./utils/ensure-carl.ts && DEBUG=true bun --env-file=datastores/pierre.env --watch run serve.ts",
    "server:embed": "cd server && BUN_PORT=3001 bun --watch tests/e2e/host-demo.html",
    "server:env": "PIERRE_ENV_FILE=server/datastores/pierre.env bun cli/src/main.ts env --init",
    "server:e2e": "bun server/tests/e2e/run.ts",
    "server:microvm:linux": "bash server/microvm/scripts/build.sh linux-amd64",
    "server:microvm:macos": "bash server/microvm/scripts/build.sh darwin-arm64",
    "server:microvm:update": "bun server/microvm/update.ts",
    "server:release": "bash server/utils/build-release.sh",
    "server:wikipedia": "cd server && bun ./utils/knowledge/scrape-wikipedia.ts",
    "test:cli": "bun test cli/tests"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.5",
    "@types/bun": "catalog:",
    "knip": "^6.44.1",
    "oxlint": "catalog:"
  }
}
