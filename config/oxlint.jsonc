{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "extends": ["./shadcn-lint.jsonc"],
  "jsPlugins": ["@shadcn/lint"],
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // Neither is in the correctness category, so the plugin alone does not
    // enable them.
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error"
  },
  "settings": {
    "shadcn": {
      "ui": "@/shared/components/ui",
      "note": "See desktop/design-system.md for design rules and approved exceptions."
    }
  },
  "env": {
    "builtin": true
  }
}
