{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // These are copied or emitted by build/package steps rather than imported as modules.
  "ignore": [
    "desktop/src/assets/report/**/*",
    "server/assets/dist/**/*",
    "server/assets/embed/*.css"
  ],
  // Installed by deployment scripts in the VM host environment, not by Bun.
  "ignoreBinaries": ["smolvm"],
  "workspaces": {
    ".": {
      "entry": [
        "config/build-server.ts!",
        "config/build-updates.ts!",
        "config/release.ts!",
        "config/release.test.ts",
        "config/checks/*.test.ts",
        "shared/**/*.test.ts"
      ],
      "ignoreDependencies": [
        // oxlint loads this plugin from a config string that Knip cannot trace.
        "@shadcn/lint",
        // The Pi extension runtime provides TypeBox inside the guest VM.
        "typebox"
      ]
    },
    "server/microvm/guest/document-extract": {
      "entry": ["extract-spreadsheet.mjs!"]
    },
    "desktop": {
      "entry": [
        "build.ts!",
        "build-plugin.ts!",
        "dev.ts!",
        "forge.config.ts!",
        "forge/rename-release-artifacts.ts!",
        "electron/main.ts!",
        "preload/index.ts!",
        "preload/mascot.ts!",
        "src/app/main.tsx!",
        "src/chat-web/main.tsx!",
        "src/mascot/main.tsx!",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "project": [
        "**/*.{ts,tsx,css}!",
        "!**/*.test.{ts,tsx}!",
        "!test/**!",
        "!src/features/repayment/lib/repayment-test-fixtures.ts!"
      ],
      // Electron Forge resolves maker packages from string names in its config.
      "ignoreDependencies": [
        "@electron-forge/maker-dmg",
        "@electron-forge/maker-squirrel",
        "@electron-forge/maker-zip",
        // desktop/build-plugin.ts spawns this binary. Knip cannot see the name.
        "@tailwindcss/cli"
      ]
    },
    "docs": {
      "entry": ["scripts/build.ts!", "scripts/**/*.test.ts"]
    },
    "marketing": {
      "entry": ["scripts/render-poster.ts!"]
    },
    "cli": {
      "entry": ["src/main.ts!", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts!"]
    },
    "server": {
      "entry": [
        "app.ts!",
        "serve.ts!",
        "assets/embed/pierre-embed.ts!",
        "assets/host/pierre.ts!",
        "microvm/update.ts!",
        "microvm/guest/extensions/ask-user.ts!",
        "utils/knowledge/scrape-wikipedia.ts!",
        "utils/update-pierre.ts!",
        "utils/ensure-carl.ts!",
        "tests/live/cm-channels.ts!",
        "tests/**/*.test.ts"
      ],
      "project": ["**/*.{ts,tsx,css}!", "!tests/**!"]
    }
  }
}
